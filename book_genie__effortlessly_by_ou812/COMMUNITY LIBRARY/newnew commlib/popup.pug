mixin bookTitle(t, bookData)
  - var bookId = t - bookStart;
  - if (t >= bookStart && bookId < bookData.length)
    .spine= bookData[bookId].title
    .cover-image(style=`background-image: url(${bookData[bookId].coverUrl || ''})`)

mixin divBlock(d)
  div(class=`block b${d}`)
    .block-inner
      .back
      .bottom
      .front
      .left
      .right
      .top

mixin labelBlock(l, bookData)
  - var bookId = l - bookStart;
  label(for=`book${bookId + 1}`, class=`block b${l}`)
    .block-inner
      .back
      .bottom
      .front
        +bookTitle(l, bookData)
      .left
      .right(data-title=bookData[bookId].title data-isbn=bookData[bookId].isbn)
        .cover
        .contents
          h1= bookData[bookId].chapters[0].title
          p= bookData[bookId].chapters[0].content
          .page-nav
            button.prev-page Previous
            button.next-page Next
      .top
      .gear-icon(data-book-id=bookId) ⚙️

form.container
  .library-header
    h1 Book Genie Community Library
    .search-bar
      input(type="text" placeholder="Search books...")
    .login-btn Login
    .mode-toggle 🌓
  .shelves
    - for (var s = 1; s <= 3; s++)
      .shelf-row(id=`shelf${s}`)
        - for (var r = 1; r <= bookData.length; r++)
          input(type="radio", name=`title${s}`, id=`book${s}-${r}`)
        .surface
          - var start = (s - 1) * Math.ceil(bookData.length / 3)
          - var end = Math.min(start + Math.ceil(bookData.length / 3), bookData.length)
          - for (var b = start + bookStart; b < end + bookStart; b++)
            - if (b >= bookStart && b < start + bookStart + bookData.length)
              +labelBlock(b, bookData)
            - else
              +divBlock(b)
  input(type="reset", value="Return")
  .popup-overlay.hidden
    .popup
      h2 Customize Book
      .upload-section
        label Upload Cover (Front)
        input(type="file" accept="image/*" data-section="front")
      .upload-section
        label Upload Cover (Back)
        input(type="file" accept="image/*" data-section="back")
      .upload-section
        label Upload Spine
        input(type="file" accept="image/*" data-section="spine")
      .upload-section
        label Upload Video
        input(type="file" accept="video/*")
      .upload-section
        label Upload Full Book (PDF/EPUB)
        input(type="file" accept=".pdf,.epub")
      .mirror-toggle
        label Mirror Cover
        input(type="checkbox")
      button.save Save
      button.cancel Cancel
.popup-overlay.hidden
  .popup(data-book-id="")
    h2 Customize Book
    .print-section
      h3 Print Options
      label Format
      select#print-format
        option(value="paperback") Paperback
        option(value="hardcover") Hardcover
      label Paper Type
      select#paper-type
        option(value="standard") Standard
        option(value="premium") Premium
      button#order-proof Order Proof Copy
    .export-section
      h3 Export Options
      button#export-epub Export EPUB
      button#export-mobi Export MOBI
